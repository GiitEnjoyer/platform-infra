{
  "policy": {
    "_meta": {
      "description": "Ingress access logs: the largest stream. 1 day hot, 7 days total; long-term traffic analytics come from metrics, not logs.",
      "apply": "PUT _ilm/policy/logs-ingress"
    },
    "phases": {
      "hot": {
        "actions": {
          "rollover": {
            "max_primary_shard_size": "40gb",
            "max_age": "1d"
          }
        }
      },
      "warm": {
        "min_age": "1d",
        "actions": {
          "allocate": {
            "require": {
              "data": "warm"
            },
            "number_of_replicas": 0
          },
          "forcemerge": {
            "max_num_segments": 1
          }
        }
      },
      "delete": {
        "min_age": "7d",
        "actions": {
          "delete": {}
        }
      }
    }
  }
}
