[
  {
    "name": "logs-app",
    "body": {
      "index_patterns": [
        "logs-app-*"
      ],
      "data_stream": {},
      "priority": 200,
      "template": {
        "settings": {
          "index.lifecycle.name": "logs-app",
          "number_of_shards": 3,
          "number_of_replicas": 1,
          "index.codec": "best_compression",
          "index.mapping.total_fields.limit": 500
        },
        "mappings": {
          "dynamic_templates": [
            {
              "strings_as_keyword": {
                "match_mapping_type": "string",
                "mapping": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            }
          ],
          "properties": {
            "@timestamp": {
              "type": "date"
            },
            "message": {
              "type": "text"
            },
            "duration": {
              "type": "long"
            },
            "status": {
              "type": "short"
            }
          }
        }
      },
      "_meta": {
        "description": "Data stream for logs-app-*; lifecycle policy logs-app. Apply: PUT _index_template/logs-app"
      }
    }
  },
